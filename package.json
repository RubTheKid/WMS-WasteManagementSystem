{
  "name": "wms-backend",
  "version": "1.0.0",
  "description": "Waste Management System - Backend API",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node server.js",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "db:setup": "ts-node src/database/setup.ts",
    "db:seed": "ts-node src/database/seed.ts",
    "db:migrate": "node run-migration.js",
    "test:login": "node test-login.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "amqplib": "^0.10.9",
    "bcryptjs": "^2.4.3",
    "compromise": "^14.14.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "natural": "^8.1.0",
    "pg": "^8.11.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.7",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
